# Copy this file to .env and fill it in. Never commit or share .env.

# ---------------- X (Twitter) ----------------
X_USERNAME=DraftsFun
# Optional: the numeric ID of @DraftsFun. The bot looks it up once and saves it
# in state.json; putting it here skips even that one lookup.
X_USER_ID=

# Option A (cheapest, $0.001 per post): the developer app is owned by the
# @DraftsFun account. Use its OAuth 1.0a keys, so reading its own posts counts as "Owned Reads".
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# Option B (simpler, $0.005 per post): any developer account, App-only Bearer Token.
# Used only if the four keys above are not all set.
X_BEARER_TOKEN=

# ---------------- Telegram ----------------
# Token from @BotFather. Chat is @yourchannel or a numeric id like -1001234567890.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---------------- Discord ----------------
# Channel settings > Integrations > Webhooks > New Webhook > Copy Webhook URL
DISCORD_WEBHOOK_URL=
# Optional: role ID to ping on each post (leave empty for no ping)
DISCORD_PING_ROLE_ID=
DISCORD_PREVIEW_CHARS=220

# ---------------- Cost / behaviour ----------------
# Seconds between checks in --loop mode (minimum 60). Checks with no new posts return nothing.
POLL_SECONDS=300
# On the very first run, how many recent posts to forward (0 = only start from new ones)
FIRST_RUN_POSTS=1
# At most this many posts are forwarded per check
MAX_POSTS_PER_RUN=5
# Local safety cap: stop calling X after this many posts read in a month
MAX_POSTS_READ_PER_MONTH=300

# ---------------- Hosting (Render) ----------------
# Postgres connection string (free Neon/Supabase). Leave empty locally to use a SQLite file.
DATABASE_URL=
# Password for the /admin panel (user: admin). Empty = panel disabled.
ADMIN_PASSWORD=
